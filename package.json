{
  "name": "attool",
  "private": true,
  "version": "0.8.5",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:runtime": "node .github/scripts/prepare-runtime.mjs",
    "build:psd-sidecar": "node .github/scripts/build-psd-sidecar.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.release.conf.json",
    "publish:catalog": "tsx .github/scripts/publish-catalog.mjs",
    "rotate:catalog-keys": "tsx .github/scripts/rotate-catalog-keys.mjs",
    "rotate:catalog-keys:prod": "tsx .github/scripts/rotate-production-catalog-keys.mjs",
    "rotate:catalog-keys:retire:prod": "tsx .github/scripts/retire-production-catalog-keys.mjs",
    "authorize:publisher:prod": "tsx .github/scripts/authorize-production-publisher.mjs",
    "test": "vitest run",
    "test:catalog": "tsx --test .github/scripts/catalog-release.node.mjs .github/scripts/catalog-key-rotation.node.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "monaco-editor": "^0.55.1",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@attson/plugin-sdk": "github:attsontools/attool-plugin-sdk#v0.1.0-alpha.0",
    "@tauri-apps/cli": "2.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "esbuild": "^0.28.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "^4.1.5"
  }
}
